load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

exports_files([
    "LICENSE",
    "README.md",
    "install.sh",
])

# Cargo.toml owns the version, dependencies, and lint levels for both build systems. The version reaches rustc as
# CARGO_PKG_VERSION, as Cargo sets it.
genrule(
    name = "cargo_env",
    srcs = ["Cargo.toml"],
    outs = ["cargo.env"],
    cmd = "sed -n '1,/^version = /s/^version = \"\\(.*\\)\"$$/CARGO_PKG_VERSION=\\1/p' $< > $@",
    visibility = ["//:__subpackages__"],
)

alias(
    name = "clnr",
    actual = "//crates/clnr",
)

# The Rust tests with their runfiles, for running on another OS without Bazel: CI cross-builds this on Linux
# (`bazel build --platforms=@rules_rs//rs/platforms:<triple> //:rust-test-bundle`) and runs each test on the target OS.
pkg_tar(
    name = "rust-test-bundle",
    testonly = True,
    srcs = [
        "//crates/clnr:clnr-test",
        "//crates/clnr-core:clnr-core-test",
        "//crates/clnr-providers:clnr-providers-test",
        "//crates/clnr-tui:clnr-tui-test",
    ],
    extension = "tar.gz",
    include_runfiles = True,
    tags = ["manual"],
)
