load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Release archives, cross-built from any host with the hermetic toolchains:
#
#   bazel build --config=release //packaging:dist
#
# bazel-bin/packaging/dist then holds one archive per target, the install script, and SHA256SUMS. Asset names carry no version so that
# `releases/latest/download/...` URLs stay stable.

# Linux binaries are static (musl), so they run on any distribution.
TARGETS = [
    "aarch64-apple-darwin",
    "aarch64-unknown-linux-musl",
    "x86_64-apple-darwin",
    "x86_64-unknown-linux-musl",
]

pkg_files(
    name = "docs",
    srcs = [
        "//:LICENSE",
        "//:README.md",
    ],
    tags = ["manual"],
)

[
    platform_transition_filegroup(
        name = triple,
        srcs = ["//crates/clnr"],
        tags = ["manual"],
        target_platform = "@rules_rs//rs/platforms:" + triple,
    )
    for triple in TARGETS
]

[
    pkg_files(
        name = triple + "_files",
        srcs = [":" + triple],
        attributes = pkg_attributes(mode = "0755"),
        tags = ["manual"],
    )
    for triple in TARGETS
]

[
    pkg_tar(
        name = triple + "_archive",
        srcs = [
            ":docs",
            ":{}_files".format(triple),
        ],
        extension = "tar.gz",
        package_dir = "clnr-" + triple,
        package_file_name = "clnr-{}.tar.gz".format(triple),
        tags = ["manual"],
    )
    for triple in TARGETS
]

ASSETS = [":{}_archive".format(triple) for triple in TARGETS] + ["//:install.sh"]

genrule(
    name = "checksums",
    srcs = ASSETS,
    outs = ["SHA256SUMS"],
    cmd = " ".join([
        "coreutils=$$PWD/$(COREUTILS_BIN);",
        "for f in $(SRCS); do (cd $$(dirname $$f) && $$coreutils sha256sum $$(basename $$f)); done | sort -k2 > $@",
    ]),
    tags = ["manual"],
    toolchains = ["@bazel_lib//lib:coreutils_toolchain_type"],
)

copy_to_directory(
    name = "dist",
    srcs = ASSETS + [":checksums"],
    root_paths = [
        ".",
        "packaging",
    ],
    tags = ["manual"],
)
